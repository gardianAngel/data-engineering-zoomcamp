# Environment variables (NEVER COMMIT)
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.env/

# Jupyter
.ipynb_checkpoints/

# Parquet / data outputs (optional for pipelines)
*.parquet

# OS files
.DS_Store

# ignore google cloud sdk
google-cloud-sdk/
*.tar.gz

# Terraform
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.tfvars
*.tfvars.json

# Default .gitignore content added by dbt Cloud# you shouldn't commit these into source control
# these are the default directory names, adjust/add to fit your needs
target/
dbt_packages/
logs/
# end dbt Cloud content
dbt_internal_packages/
